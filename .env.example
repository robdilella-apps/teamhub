# --- Backend (Supabase) -------------------------------------------------------
# After `npx supabase start`, copy "API URL" and "anon key" from its output.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=paste-your-local-anon-key-here

# Set to "true" to run fully in the browser with sample data and no backend.
VITE_DEMO_MODE=false

# --- Branding (all optional) --------------------------------------------------
VITE_APP_NAME=TeamHub
VITE_COMPANY_NAME=Sample Business Co
VITE_TAGLINE=Team chat for your business
VITE_BRAND_COLOR=#4f46e5
# Words your business uses (e.g. "store", "restaurant", "office", "site")
VITE_LOCATION_LABEL=Location
